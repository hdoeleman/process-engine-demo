<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
    </module>

    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No tab characters -->
    <module name="FileTabCharacter"/>

    <!-- Maximum line length: 150, not the kata-tuned 120 — this codebase's javadoc prose runs
         noticeably longer (explaining invariants and the reasoning behind non-obvious decisions),
         and reflowing every such comment to fit 120 would be pure churn on already-reviewed,
         working text for no behavioral benefit. Still a real limit, not effectively unbounded. -->
    <module name="LineLength">
        <property name="max" value="150"/>
    </module>

    <module name="TreeWalker">

        <!-- Naming conventions -->
        <module name="TypeName"/>
        <module name="ConstantName">
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>

        <!-- No wildcard imports (static imports are permitted) -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- Braces required on all blocks -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- No magic numbers (common values exempted) -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>

        <!-- Whitespace -->
        <module name="WhitespaceAround">
            <!-- Palantir/Spotless formats every empty block — constructors, methods, class/
                 record/enum bodies, lambdas, loops — as `{}` with no internal space; allow all
                 of them rather than fighting the formatter one violation type at a time. -->
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="NoWhitespaceAfter">
            <!-- Drops ARRAY_INIT from the default tokens so `new T[]{ a, b }` is allowed. -->
            <property name="tokens"
                      value="AT, INC, DEC, UNARY_MINUS, UNARY_PLUS, BNOT, LNOT, DOT, ARRAY_DECLARATOR, INDEX_OP"/>
        </module>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
        </module>

        <!-- Modifiers in correct order -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Design -->
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="false"/>
            <property name="protectedAllowed" value="false"/>
        </module>

        <!-- Code quality -->
        <module name="EmptyBlock"/>
        <module name="EmptyCatchBlock"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <!-- 90, not the kata-tuned 20: this codebase's state-machine/dispatch methods routinely
             carry substantial inline commentary explaining *why* (invariants, ADR references,
             prior-review findings) alongside the logic itself — a deliberate, valued style here,
             not a smell. Still catches genuinely oversized methods; it just doesn't fight a
             heavily-annotated 30-40 line method with real, cohesive logic. -->
        <module name="MethodLength">
            <property name="max" value="90"/>
        </module>
        <!-- METHOD_DEF only, not CTOR_DEF: Spring constructor injection routinely wires 6+
             collaborators into a service, which is normal DI composition, not the kind of
             parameter-list smell this check exists to catch. -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- Annotations -->
        <module name="MissingOverride"/>

    </module>

</module>
